# ============================================================
# deodorant-reborn-platform — .gitignore
# ============================================================

# ── Environment variables ────────────────────────────────────
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# ── Next.js ─────────────────────────────────────────────────
.next/
out/

# ── Node.js ─────────────────────────────────────────────────
node_modules/

# ── Build outputs ────────────────────────────────────────────
dist/
build/

# ── Copilot Agent instructions (local AI config — not for public repo) ─
.github/agents/
.vscode/copilot-agents/
*.agent.md

# ── IDE & Editor ─────────────────────────────────────────────
.vscode/settings.json
.idea/
*.iml

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Hosting platforms ────────────────────────────────────────
.vercel/
.render/

# ── Test coverage ────────────────────────────────────────────
coverage/
.nyc_output/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*

# ── v0 sandbox internal files ────────────────────────────────
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
