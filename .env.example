# ============================================================
# deodorant-reborn-platform — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── GitHub API ───────────────────────────────────────────────
# Personal Access Token (read-only, public_repo scope)
# Used for fetching stars, contributors, release data
GITHUB_TOKEN=ghp_your_github_token

# The GitHub repo slug (owner/repo) for the plugin
GITHUB_REPO=your-username/intellij-deodorant-reborn

# ── Spring Boot Backend ──────────────────────────────────────
# URL of the deployed backend (Render free tier)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ── Analytics ───────────────────────────────────────────────
# Vercel Analytics is enabled automatically in production.
# No additional env var needed.

# ── Internationalisation ─────────────────────────────────────
# Default locale for the application
NEXT_PUBLIC_DEFAULT_LOCALE=en
